# ANEF Residence Permit Tracker — Environment Configuration Template
# Copy this file to .env and adjust as needed.

# Application Environment
ANEF_ENV=production
LOG_LEVEL=info

# SQLite Database Location
DATABASE_PATH=data/anef.db

# Storage Immutability
STORAGE_IMMUTABLE_SNAPSHOTS=true

# Notification Settings
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_DESKTOP=true
NOTIFICATIONS_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_HERE

# Retention Policy (Days)
RETENTION_HTTP_LOGS_DAYS=365

# Security Settings
SECURITY_ENCRYPTION_ENABLED=false
SECURITY_KEY_SOURCE=env
